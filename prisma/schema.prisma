generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  CHEF
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY_FOR_PICKUP
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REFUNDED
}

enum OrderType {
  DAILY_MEAL
  PANTRY_ITEM
  FUEL_PLAN
  SOCIAL_EVENT
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum DeliveryStatus {
  PENDING
  ASSIGNED
  PICKED_UP
  DELIVERED
  FAILED
}

enum ChefApplicationStatus {
  DRAFT
  PENDING_REVIEW
  PHONE_VETTING
  KITCHEN_AUDIT
  APPROVED
  REJECTED
}

enum DietaryPreference {
  VEG
  NON_VEG
  BOTH
}

enum FaultType {
  CHEF
  DRIVER
  CUSTOMER
}

enum FuelSubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
  COMPLETED
}

enum FuelFulfillmentStatus {
  SCHEDULED
  COOKING
  READY_FOR_PICKUP
  PICKED_UP
  DELIVERED
  PAUSED
  MISSED
  CANCELLED
}

model User {
  id         String   @id @default(uuid())
  name       String
  phone      String   @unique
  email      String   @unique
  password   String
  role       Role     @default(USER)
  gender     Gender?  @default(OTHER)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  dietary_preference DietaryPreference @default(BOTH)
  fitness_goals      String[]          @default([])

  latitude  Float?
  longitude Float?

  chef               Chef?
  follows            Follow[]           @relation("UserFollows")
  orders             Order[]
  addresses          Address[]
  fuel_subscriptions FuelSubscription[]
  push_tokens        DevicePushToken[]
}

model DevicePushToken {
  id         String   @id @default(uuid())
  user_id    String
  user       User     @relation(fields: [user_id], references: [id])
  token      String   @unique
  platform   String?
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([user_id, is_active])
}

model Address {
  id           String   @id @default(uuid())
  user_id      String
  user         User     @relation(fields: [user_id], references: [id])
  label        String // Home, Work, etc.
  address_line String
  city         String
  state        String
  zip_code     String
  latitude     Float?
  longitude    Float?
  is_default   Boolean  @default(false)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  delivery_orders Order[] @relation("OrderDeliveryAddress")
}

model Chef {
  id          String   @id @default(uuid())
  name        String
  phone       String   @unique
  email       String   @unique
  password    String
  role        Role     @default(CHEF)
  bio         String?
  rating      Float    @default(0.0)
  is_verified Boolean  @default(false)
  trust_tier  Int      @default(1)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  // Step 1: Personal Info
  primary_cuisine String?

  // Step 2: Kitchen Space
  kitchen_name                  String?
  kitchen_address               String?
  latitude                      Float?
  longitude                     Float?
  max_capacity                  Int?     @default(10)
  max_concurrent_slots_per_hour Int      @default(15)
  appliances                    String[] @default([])

  // Step 3: Security & Verification
  government_id_url    String?
  food_safety_cert_url String?
  kitchen_photo_url    String?

  // Bank details
  bank_name           String?
  bank_account_number String?
  ifsc_code           String?

  // Registration tracking
  application_status ChefApplicationStatus @default(DRAFT)
  registration_step  Int                   @default(1)

  user_id            String?                @unique
  user               User?                  @relation(fields: [user_id], references: [id])
  followers          Follow[]               @relation("ChefFollowers")
  meals              DailyMeal[]
  pantry             PantryItem[]
  fuel_slots         FuelSlot[]
  fuel_subscriptions FuelSubscription[]
  fuel_fulfillments  FuelDailyFulfillment[]
  social_events      SocialEvent[]
  orders             Order[]
}

model Follow {
  id      String @id @default(uuid())
  user_id String
  chef_id String
  user    User   @relation("UserFollows", fields: [user_id], references: [id])
  chef    Chef   @relation("ChefFollowers", fields: [chef_id], references: [id])

  @@unique([user_id, chef_id])
}

model DailyMeal {
  id              String   @id @default(uuid())
  chef_id         String
  chef            Chef     @relation(fields: [chef_id], references: [id])
  meal_name       String
  type            String // dietary type: VEG, NON_VEG
  service_window  String? // LUNCH, DINNER
  image_url       String?
  price           Float
  slots_total     Int
  slots_remaining Int
  batch_photo_url String? // For proof of batch/pickup
  date            DateTime
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  order_items OrderItem[]
}

model FuelPlan {
  id                  String   @id @default(uuid())
  name                String
  goal                String
  description         String
  price               Float
  duration_days       Int      @default(30)
  price_to_customer   Float?
  fixed_chef_payout   Float?
  sop_document_url    String?
  delivery_time_slots String[] @default([])
  menu_json           Json
  calories            Int?
  protein             Int?
  carbs               Int?
  fat                 Int?
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  slots         FuelSlot[]
  subscriptions FuelSubscription[]
}

model FuelSlot {
  id              String   @id @default(uuid())
  chef_id         String
  chef            Chef     @relation(fields: [chef_id], references: [id])
  plan_id         String
  plan            FuelPlan @relation(fields: [plan_id], references: [id])
  time_slot       String
  capacity        Int
  slots_remaining Int
  created_at      DateTime @default(now())

  order_items OrderItem[]
}

model FuelSubscription {
  id                 String                 @id @default(uuid())
  user_id            String
  user               User                   @relation(fields: [user_id], references: [id])
  plan_id            String
  plan               FuelPlan               @relation(fields: [plan_id], references: [id])
  assigned_chef_id   String
  assigned_chef      Chef                   @relation(fields: [assigned_chef_id], references: [id])
  status             FuelSubscriptionStatus @default(ACTIVE)
  start_date         DateTime
  end_date           DateTime
  delivery_time_slot String
  created_at         DateTime               @default(now())
  updated_at         DateTime               @updatedAt

  fulfillments FuelDailyFulfillment[]
  order_items  OrderItem[]

  @@index([user_id])
  @@index([assigned_chef_id, delivery_time_slot, status])
}

model FuelDailyFulfillment {
  id                        String                @id @default(uuid())
  subscription_id           String
  subscription              FuelSubscription      @relation(fields: [subscription_id], references: [id])
  chef_id                   String
  chef                      Chef                  @relation(fields: [chef_id], references: [id])
  fulfillment_date          DateTime
  delivery_time_slot        String
  delivery_status           FuelFulfillmentStatus @default(SCHEDULED)
  chef_batch_photo_url      String?
  weight_verification_grams Int?
  chef_reminder_sent_at     DateTime?
  created_at                DateTime              @default(now())
  updated_at                DateTime              @updatedAt

  @@unique([subscription_id, fulfillment_date])
  @@index([chef_id, fulfillment_date, delivery_time_slot])
}

model PantryItem {
  id         String   @id @default(uuid())
  chef_id    String
  chef       Chef     @relation(fields: [chef_id], references: [id])
  name       String
  category   String
  price      Float
  inventory  Int
  image_url  String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  order_items OrderItem[]
}

model SocialEvent {
  id              String   @id @default(uuid())
  chef_id         String
  chef            Chef     @relation(fields: [chef_id], references: [id])
  title           String
  description     String
  date            DateTime
  end_date        DateTime
  location        String
  price           Float
  slots_total     Int
  slots_remaining Int
  social_balance  Boolean  @default(false)
  image_url       String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  order_items OrderItem[]
}

model Order {
  id                  String      @id @default(uuid())
  user_id             String
  chef_id             String
  delivery_address_id String?
  user                User        @relation(fields: [user_id], references: [id])
  chef                Chef        @relation(fields: [chef_id], references: [id])
  delivery_address    Address?    @relation("OrderDeliveryAddress", fields: [delivery_address_id], references: [id])
  order_type          OrderType
  status              OrderStatus @default(PENDING)
  total_price         Float
  fault_type          FaultType?
  created_at          DateTime    @default(now())
  updated_at          DateTime    @updatedAt

  items    OrderItem[]
  payment  Payment?
  delivery Delivery?

  @@index([delivery_address_id])
}

model OrderItem {
  id       String @id @default(uuid())
  order_id String
  order    Order  @relation(fields: [order_id], references: [id])

  // Polymorphic-like relation via manual tracking
  item_id  String
  quantity Int
  price    Float // Price at the time of order

  // Relations to actual items (at least one should be populated based on OrderType)
  daily_meal_id   String?
  daily_meal      DailyMeal?   @relation(fields: [daily_meal_id], references: [id])
  pantry_id       String?
  pantry_item     PantryItem?  @relation(fields: [pantry_id], references: [id])
  fuel_slot_id    String?
  fuel_slot       FuelSlot?    @relation(fields: [fuel_slot_id], references: [id])
  fuel_subscription_id                 String?           @unique
  fuel_subscription                    FuelSubscription? @relation(fields: [fuel_subscription_id], references: [id])
  fuel_subscription_start_date         DateTime?
  fuel_subscription_delivery_time_slot String?
  social_event_id String?
  social_event    SocialEvent? @relation(fields: [social_event_id], references: [id])
}

model Payment {
  id                  String        @id @default(uuid())
  order_id            String        @unique
  order               Order         @relation(fields: [order_id], references: [id])
  amount              Float
  currency            String        @default("INR")
  status              PaymentStatus @default(PENDING)
  gateway_id          String? // Legacy gateway reference. For Razorpay this mirrors razorpay_order_id.
  razorpay_order_id   String?       @unique
  razorpay_payment_id String?       @unique
  razorpay_signature  String?
  razorpay_receipt    String?
  escrow_status       String        @default("PENDING") // PENDING, HELD, RELEASED, REFUNDED
  created_at          DateTime      @default(now())
  updated_at          DateTime      @updatedAt
}

model DeliveryPartner {
  id           String   @id @default(uuid())
  name         String // e.g., "Shadowfax"
  phone_number String?
  is_active    Boolean  @default(true)
  api_key      String? // Encrypted API Key securely stored
  base_url     String? // External API base URL
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  deliveries Delivery[]
}

model Delivery {
  id                    String           @id @default(uuid())
  order_id              String           @unique
  order                 Order            @relation(fields: [order_id], references: [id])
  partner_id            String?
  partner               DeliveryPartner? @relation(fields: [partner_id], references: [id])
  external_tracking_id  String? // Stores external delivery tracking code
  external_tracking_url String? // Stores external live map tracking URL
  pickup_time           DateTime?
  delivered_time        DateTime?
  pod_image             String? // Proof of Delivery
  status                DeliveryStatus   @default(PENDING)
  created_at            DateTime         @default(now())
  updated_at            DateTime         @updatedAt
}
