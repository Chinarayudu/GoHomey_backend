# Copy to .env and fill in real values. Never commit the real .env.

PORT=3000
NODE_ENV=production

# Comma-separated list of allowed frontend origins, e.g.
# CORS_ORIGIN=https://app.example.com,https://admin.example.com
# Leave unset to allow all origins.
CORS_ORIGIN=

# Generate with: openssl rand -hex 32
JWT_SECRET=

DATABASE_URL=

REDIS_HOST=
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_TLS=true

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

BORZO_API_TOKEN=
BORZO_BASE_URL=
BORZO_WEBHOOK_SECRET=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

HOMEY_PLATFORM_FEE_RUPEES=20

CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

FUEL_SCHEDULER_ENABLED=true

SHADOWFAX_API_MODE=production
SHADOWFAX_API_TOKEN=
SHADOWFAX_BASE_URL=
SHADOWFAX_CREDITS_KEY=
SHADOWFAX_CLIENT_CODE=
SHADOWFAX_ENVIRONMENT=
SHADOWFAX_MOCK=false
SHADOWFAX_USE_STAGING_SERVICEABLE_COORDS=false
