# Copy to .env and fill in real values. Never commit the real .env.

PORT=3000
NODE_ENV=production

# Comma-separated list of allowed frontend origins, e.g.
# CORS_ORIGIN=https://app.example.com,https://admin.example.com
# Leave unset to allow all origins.
CORS_ORIGIN=

# Generate with: openssl rand -hex 32
JWT_SECRET=

# TEMPORARY TESTING BYPASS — DO NOT leave true once real users can reach this API.
# When true: /auth/send-otp always succeeds without sending a real SMS, and
# /auth/verify-otp accepts ANY otp value for ANY phone number (full phone-verification
# bypass — no proof of phone ownership at all). Only for use while DLT is pending.
OTP_BYPASS_ENABLED=false

DATABASE_URL=

REDIS_HOST=
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_TLS=true

# MSG91 (OTP SMS) — legacy path, kept working during Firebase migration.
# Requires a DLT-registered sender ID + template on the MSG91 dashboard for
# Indian numbers. template_id below is the MSG91 template id (not the DLT
# template id), and its variable name must be "OTP" to match src/auth/auth.service.ts.
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Firebase Phone Auth — from Firebase Console > Project Settings > Service
# accounts > Generate new private key. Paste the JSON file's fields here.
# FIREBASE_PRIVATE_KEY must keep its \n escapes literal (don't unescape them
# in .env) — the app converts them back to real newlines at runtime.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

BORZO_API_TOKEN=
BORZO_BASE_URL=
BORZO_WEBHOOK_SECRET=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

HOMEY_PLATFORM_FEE_RUPEES=20

CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

FUEL_SCHEDULER_ENABLED=true

SHADOWFAX_API_MODE=production
SHADOWFAX_API_TOKEN=
SHADOWFAX_BASE_URL=
SHADOWFAX_CREDITS_KEY=
SHADOWFAX_CLIENT_CODE=
SHADOWFAX_ENVIRONMENT=
SHADOWFAX_MOCK=false
SHADOWFAX_USE_STAGING_SERVICEABLE_COORDS=false
